+#[derive(Debug, Default, PartialEq)]
+struct GeoLocation {
+    city: Option<String>,
+    coords: Option<(f64, f64)>,
+}
+
+fn valid_coordinates(lat: f64, lon: f64) -> Option<(f64, f64)> {
+    if lat.is_finite()
+        && lon.is_finite()
+        && (-90.0..=90.0).contains(&lat)
+        && (-180.0..=180.0).contains(&lon)
+    {
+        Some((lat, lon))
+    } else {
+        None
+    }
+}
+
+fn parse_coordinate_pair(value: &str) -> Option<(f64, f64)> {
+    let (lat, lon) = value.trim().split_once(',')?;
+    valid_coordinates(lat.trim().parse().ok()?, lon.trim().parse().ok()?)
+}
+
+fn parse_ipinfo_location(text: &str) -> Option<GeoLocation> {
+    let data: Value = serde_json::from_str(text).ok()?;
+    let city = data
+        .get("city")
+        .and_then(Value::as_str)
+        .map(str::trim)
+        .filter(|city| !city.is_empty())
+        .map(str::to_owned);
+    let coords = data
+        .get("loc")
+        .and_then(Value::as_str)
+        .and_then(parse_coordinate_pair)
+        .or_else(|| {
+            let lat = data.get("lat")?.as_f64()?;
+            let lon = data.get("lon")?.as_f64()?;
+            valid_coordinates(lat, lon)
+        });
+
+    if city.is_none() && coords.is_none() {
+        return None;
+    }
+
+    Some(GeoLocation { city, coords })
+}
+
+fn parse_cip_cc_city(text: &str) -> Option<String> {
+    let address = text.lines().find_map(|line| {
+        let (key, value) = line.split_once(':')?;
+        (key.trim() == "地址").then_some(value.trim())
+    })?;
+    let city = address
+        .split_whitespace()
+        .last()?
+        .trim_end_matches('市')
+        .trim();
+
+    if city.is_empty() || city == "中国" {
+        None
+    } else {
+        Some(city.to_string())
+    }
