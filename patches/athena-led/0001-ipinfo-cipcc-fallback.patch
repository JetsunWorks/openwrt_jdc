+#[cfg(test)]
+mod geo_location_tests {
+    use super::{parse_cip_cc_city, parse_ipinfo_location};
+
+    #[test]
+    fn parses_ipinfo_city_and_loc() {
+        let location = parse_ipinfo_location(
+            r#"{"city":"Beijing","loc":"39.9075,116.3972"}"#,
+        )
+        .expect("valid ipinfo response");
+
+        assert_eq!(location.city.as_deref(), Some("Beijing"));
+        assert_eq!(location.coords, Some((39.9075, 116.3972)));
+    }
+
+    #[test]
+    fn parses_ipinfo_lat_lon_fields_as_fallback() {
+        let location = parse_ipinfo_location(r#"{"lat":39.9,"lon":116.3}"#)
+            .expect("valid coordinate response");
+
+        assert_eq!(location.coords, Some((39.9, 116.3)));
+    }
+
+    #[test]
+    fn parses_cip_cc_city_from_chinese_address() {
+        assert_eq!(
+            parse_cip_cc_city("IP : 111.193.233.171\n地址    : 中国 北京 北京\n"),
+            Some("北京".to_string())
+        );
+    }
+
+    #[test]
+    fn rejects_invalid_location_values() {
+        assert!(parse_ipinfo_location(r#"{"city":"","loc":"999,999"}"#).is_none());
+        assert!(parse_cip_cc_city("<html>no location</html>").is_none());
+    }
+}

